% MATLAB Script for Implementing LQR Controller 
% Scope: Linearizing Plant Only 


warning('off','all');


% Simulink File
modelFile = 'root';

% Check if model is open
if ~bdIsLoaded(modelFile)
    load_system(modelFile);
end


spec = operspec(modelFile); % create operation point specs 
op = findop(modelFile, spec); % determine operation point

% Define I/Os of plant

io(1) = linio('root/Demux1', 1, 'input');
io(2) = linio('root/Demux2', 2, 'input');
io(3) = linio('root/LPF1', 1, 'input');
io(4) = linio('root/LPF2', 1, 'input');
io(5) = linio('root/Multibody Sim', 1, 'output');
io(6) = linio('root/Multibody Sim', 2, 'output');
io(7) = linio('root/Multibody Sim', 3, 'output');
io(8) = linio('root/Multibody Sim', 4, 'output');
io(9) = linio('root/Multibody Sim', 5, 'output');
io(10) = linio('root/Multibody Sim', 6, 'output');


